{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slt.org/schemas/participant.schema.json",
  "title": "ParticipantRecord",
  "description": "Schema for pseudonymous participant registry entries",
  "type": "object",
  "required": ["signer_id", "metadata_json", "created_at_utc"],
  "properties": {
    "signer_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "metadata_json": { "type": "string" },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
