{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slt.org/schemas/annotation.schema.json",
  "title": "AnnotationRecord",
  "description": "Schema for semi-open nanosecond bounded linguistic annotations",
  "type": "object",
  "required": [
    "annotation_id",
    "document_id",
    "tier_id",
    "start_ns",
    "end_ns",
    "value",
    "boundary_quality",
    "status",
    "revision"
  ],
  "properties": {
    "annotation_id": { "type": "string" },
    "document_id": { "type": "string" },
    "tier_id": { "type": "string" },
    "start_ns": { "type": "integer", "minimum": 0 },
    "end_ns": { "type": "integer", "minimum": 1 },
    "value": { "type": "string" },
    "parent_annotation_id": { "type": ["string", "null"] },
    "boundary_quality": {
      "type": "string",
      "enum": ["exact", "approximate", "unverified"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "adjudicated", "rejected"]
    },
    "annotator_id": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
